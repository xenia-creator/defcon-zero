# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_DB=defcon
POSTGRES_PASSWORD=replace_with_secure_password
APP_DB_PASSWORD=replace_with_secure_password

# Application database URLs
DATABASE_URL=postgresql+asyncpg://defcon_app:replace_with_secure_password@db:5432/defcon
TEST_DATABASE_URL=postgresql+asyncpg://defcon_app:replace_with_secure_password@db:5432/defcon_test

# Application authentication
JWT_SECRET=replace_with_a_long_random_secret

# Frontend origin
CORS_ORIGINS=http://localhost:5173
