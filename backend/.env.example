# Template for backend/.env, which is never committed. Copy it and use real values:
#   cp .env.example .env

# The +asyncpg part tells SQLAlchemy which driver to use. It is required.
DATABASE_URL=postgresql+asyncpg://defcon_app:fake-password@localhost:5432/defcon

# Signs login tokens. Generate a real one with: openssl rand -hex 32
JWT_SECRET=fake-secret-replace-me
