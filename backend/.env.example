# Template for backend/.env, which is never committed. Copy it and use real values:
#   cp .env.example .env

# The +asyncpg part tells SQLAlchemy which driver to use. It is required.
DATABASE_URL=postgresql+asyncpg://defcon_app:fake-password@localhost:5432/defcon

# The database the tests use, which they wipe between tests. Never point this at
# real data. The tests refuse to run unless the database is named defcon_test.
TEST_DATABASE_URL=postgresql+asyncpg://defcon_app:fake-password@localhost:5432/defcon_test

# Signs login tokens. Generate a real one with: openssl rand -hex 32
JWT_SECRET=fake-secret-replace-me

# Browser origins allowed to call the API, comma separated, with no trailing slash.
# Leave it out for local development: the default is the Vite dev server,
# http://localhost:5173 and http://127.0.0.1:5173. The event server sets it to
# the frontend's address, for example:
# CORS_ORIGINS=https://defcon.example.org
